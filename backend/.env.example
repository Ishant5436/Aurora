# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4000

# MongoDB Atlas: Database > Connect > Drivers > copy the connection string, then
# add your IP under Network Access. For a local mongod use:
#   mongodb://127.0.0.1:27017/aurora
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aurora?retryWrites=true&w=majority

# At least 32 random characters, for example: openssl rand -hex 32
JWT_SECRET=change-me-change-me-change-me-change-me
JWT_EXPIRES_IN=30d

# Comma-separated origins for Flutter web, or * to allow any.
CORS_ORIGIN=*
# Set to 1 when deployed behind a single reverse proxy (Render, Railway, Fly).
TRUST_PROXY=0

# Optional but recommended: AI question generation, voice grading, notes-to-quiz.
# Without a key the app serves the built-in question bank, voice uses a dev-only
# heuristic, and uploading notes returns 503.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Tried first for audio and PDFs; handles both. Point at a stronger model if you
# like: when it is overloaded the request falls back to GEMINI_MODEL.
GEMINI_MULTIMODAL_MODEL=gemini-3.5-flash-lite
# GEMINI_FALLBACK_MODEL=          # optional last resort after every other model
# GEMINI_BACKOFF_MS=500,1500      # pauses between retries of a busy model
# ALLOW_MOCK_VOICE=true   # defaults to true outside production
